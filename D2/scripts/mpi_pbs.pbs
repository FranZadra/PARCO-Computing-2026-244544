#!/bin/bash

#PBS -N spmv_mpi
#PBS -o ../results/benchmark_mpi.out
#PBS -e ../results/benchmark_mpi.err
#PBS -q short_cpuQ
#PBS -l walltime=12:00:00
#PBS -l select=4:ncpus=24:mpiprocs=24:mem=32gb

# ============================================================
# MPI SpMV Benchmark Job Script for PBS
# ============================================================

# Load required modules
module load gcc91
module load mpich-3.2        # Adjust to your cluster's MPI module
# Alternative MPI modules (uncomment the one your cluster uses):
# module load openmpi
# module load intel-mpi
# module load mvapich2

# Working directory
cd "$PBS_O_WORKDIR"

# Create necessary directories
mkdir -p ../results
mkdir -p ../plots

# ============================================================
# DISPLAY JOB INFORMATION
# ============================================================

echo "=========================================="
echo "MPI SpMV BENCHMARK JOB"
echo "=========================================="
echo "Job ID:            $PBS_JOBID"
echo "Job Name:          $PBS_JOBNAME"
echo "Queue:             $PBS_QUEUE"
echo "Working Directory: $(pwd)"
echo "Start time:        $(date)"
echo ""
echo "--- PBS Resource Request ---"
echo "Nodes:             4"
echo "CPUs per node:     24"
echo "MPI procs/node:    24"
echo "Total MPI procs:   96"
echo "Memory per node:   32 GB"
echo "Walltime:          12:00:00"
echo "=========================================="
echo ""

# ============================================================
# SAVE SYSTEM AND NODE INFORMATION
# ============================================================

echo "Saving system information..."
SYSTEM_INFO_FILE="../results/system_info_${PBS_JOBID}.txt"

{
    echo "=========================================="
    echo "SYSTEM INFORMATION"
    echo "=========================================="
    echo ""
    echo "Job ID: $PBS_JOBID"
    echo "Job Name: $PBS_JOBNAME"
    echo "Date: $(date)"
    echo ""
    
    echo "--- Allocated Nodes ---"
    cat "$PBS_NODEFILE" | sort | uniq
    echo ""
    echo "Total nodes: $(cat $PBS_NODEFILE | sort | uniq | wc -l)"
    echo "Total processes: $(cat $PBS_NODEFILE | wc -l)"
    echo ""
    
    echo "--- Master Node: $(hostname) ---"
    echo ""
    
    echo "--- CPU Model ---"
    lscpu | grep "Model name"
    echo ""
    
    echo "--- Architecture Details ---"
    lscpu | grep -E "Architecture|CPU\(s\)|Thread|Core|Socket|NUMA"
    echo ""
    
    echo "--- CPU Frequencies ---"
    lscpu | grep -E "MHz|max|min"
    echo ""
    
    echo "--- Cache Information ---"
    lscpu | grep -i cache
    echo ""
    
    echo "--- Memory Information ---"
    free -h
    echo ""
    
    echo "--- Network Information ---"
    ifconfig | grep -A 1 "inet " | grep -v "127.0.0.1"
    echo ""
    
    echo "--- MPI Information ---"
    which mpicc
    mpicc --version
    which mpirun
    mpirun --version 2>&1 | head -5
    echo ""
    
    echo "--- Full lscpu Output ---"
    lscpu
    echo ""
    
    echo "=========================================="
    
} > "$SYSTEM_INFO_FILE"

echo "System info saved to: $SYSTEM_INFO_FILE"
echo ""

# ============================================================
# VERIFY ENVIRONMENT
# ============================================================

echo "Verifying environment..."

# Check directories
if [ ! -d "../src" ] || [ ! -d "../include" ] || [ ! -d "../data" ]; then
    echo "ERROR: Required directories (src/include/data) not found"
    exit 1
fi

# Check benchmark script
if [ ! -f "benchmark_mpi.sh" ]; then
    echo "ERROR: benchmark_mpi.sh not found"
    echo "Expected location: $(pwd)/benchmark_mpi.sh"
    exit 1
fi

# Make script executable
chmod +x benchmark_mpi.sh

# Check for matrices
NUM_MATRICES=$(ls ../data/*.mtx 2>/dev/null | wc -l)
if [ "$NUM_MATRICES" -eq 0 ]; then
    echo "WARNING: No .mtx files found in ../data/"
    echo "Benchmark will only run weak scaling tests with synthetic matrices"
else
    echo "Found $NUM_MATRICES matrix files for strong scaling"
fi

# Check MPI environment
if ! command -v mpirun &> /dev/null; then
    echo "ERROR: mpirun not found. Check MPI module is loaded."
    exit 1
fi

echo "Environment check passed."
echo ""

# ============================================================
# MPI CONFIGURATION
# ============================================================

echo "Configuring MPI environment..."

# Set MPI environment variables for better performance
export OMPI_MCA_btl=^openib              # Disable InfiniBand (if not available)
export I_MPI_FABRICS=shm:tcp             # Use shared memory + TCP
export I_MPI_PIN_DOMAIN=auto             # Auto process pinning
export OMP_NUM_THREADS=1                 # Disable OpenMP threading

# For MVAPICH2 (uncomment if using MVAPICH2):
# export MV2_ENABLE_AFFINITY=1
# export MV2_CPU_BINDING_POLICY=scatter

# For OpenMPI (uncomment if using OpenMPI):
# export OMPI_MCA_mpi_warn_on_fork=0

echo "MPI configuration set."
echo ""

# ============================================================
# DISPLAY MPI INFORMATION
# ============================================================

echo "--- MPI Setup ---"
echo "MPI compiler: $(which mpicc)"
echo "MPI launcher: $(which mpirun)"
echo ""

# Test MPI connectivity (optional but recommended)
echo "Testing MPI connectivity with 4 processes..."
mpirun -np 4 hostname
echo ""

# ============================================================
# RUN BENCHMARK
# ============================================================

echo "=========================================="
echo "STARTING MPI SPMV BENCHMARK"
echo "=========================================="
echo ""

# Run the benchmark script
./benchmark_mpi.sh

exit_code=$?

echo ""
echo "=========================================="

if [ $exit_code -eq 0 ]; then
    echo "BENCHMARK COMPLETED SUCCESSFULLY"
    
    # ============================================================
    # RESULTS SUMMARY
    # ============================================================
    
    echo ""
    echo "=========================================="
    echo "RESULTS SUMMARY"
    echo "=========================================="
    
    if [ -f "../results/strong_scaling.csv" ]; then
        num_strong=$(tail -n +2 ../results/strong_scaling.csv | wc -l)
        echo "Strong scaling tests: $num_strong runs"
        echo "  Output: ../results/strong_scaling.csv"
    fi
    
    if [ -f "../results/weak_scaling.csv" ]; then
        num_weak=$(tail -n +2 ../results/weak_scaling.csv | wc -l)
        echo "Weak scaling tests: $num_weak runs"
        echo "  Output: ../results/weak_scaling.csv"
    fi
    
    echo ""
    echo "System info: $SYSTEM_INFO_FILE"
    echo ""
    echo "=========================================="
    echo "TO GENERATE PLOTS, RUN MANUALLY:"
    echo "  cd scripts"
    echo "  python3 plot_scaling.py"
    echo "=========================================="
    
else
    echo "BENCHMARK FAILED (exit code: $exit_code)"
    echo "Check error log: ../results/benchmark_mpi.err"
fi

echo ""
echo "=========================================="
echo "End time: $(date)"
echo "Total runtime: $SECONDS seconds"
echo "=========================================="

exit $exit_code